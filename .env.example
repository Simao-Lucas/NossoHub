APP_NAME="Nosso Hub"
APP_URL=http://localhost:2807
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=nosso_hub
DB_USERNAME=nosso_hub
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

MEDIA_ROOT=/app/media

# URL alcançável DE DENTRO do container nosso_hub_web (rede homelab).
# immich.local costuma falhar no Docker ("Temporary failure in name resolution").
# Use o nome do serviço/container Immich na rede, ex.:
#   http://immich-server:2283
#   http://immich_server:3001
# Descubra com: docker network inspect homelab
IMMICH_BASE_URL=http://immich-server:2283
IMMICH_API_KEY=
IMMICH_TIMEOUT=30

RELATIONSHIP_SINCE=2025-07-28T20:30:00-03:00
